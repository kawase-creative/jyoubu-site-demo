{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jyoubu-site-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-05",
  "workers_dev": true,
  "observability": { "enabled": true },
  "vars": {
    "ALLOWED_ORIGIN": "https://kawase-creative.github.io"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jyoubu-site-content",
      "database_id": "fcf10b1e-3789-4869-b54b-6900162fd2b9",
      "migrations_dir": "../database/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "jyoubu-site-media"
    }
  ]
}
